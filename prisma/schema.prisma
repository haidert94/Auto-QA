generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnvironmentType {
  DEVELOPMENT
  QA
  STAGING
  PRODUCTION
}

enum ProjectStatus {
  DRAFT
  READY
  ARCHIVED
}

enum AccessMode {
  PUBLIC
  PRIVATE
  SSO
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum ResultStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum DocumentType {
  USER_STORY
  REQUIREMENTS
  ACCEPTANCE_CRITERIA
  BUSINESS_RULE
  FLOW
  API
  OTHER
}

enum AssessmentType {
  READINESS
  TEST_QUALITY
}

model User {
  passwordHash   String?
  verifiedAt     DateTime?
  consentVersion String?
  consentAt      DateTime?
  membership     OrganizationMember?
  projectMemberships ProjectMember[]
  sessions       AccountSession[]
  accountTokens  AccountToken[]
  id             String              @id @default(uuid())
  email          String              @unique
  name           String?
  projects       Project[]
  explorations   Exploration[]
  runs           TestRun[]
  performanceAudits PerformanceAudit[]
  monitors          Monitor[]
  loadTests         LoadTest[]
  automationJobs    AutomationJob[]
  uxAudits          UxAudit[]
  invitesCreated OrganizationInvite[] @relation("InviteAuthor")
  audits         AccessAudit[]
  createdAt      DateTime            @default(now())
}

model Project {
  organizationId         String?
  organization           Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                     String              @id @default(uuid())
  name                   String
  description            String?
  status                 ProjectStatus       @default(DRAFT)
  authorizationConfirmed Boolean             @default(false)
  authorizedAt           DateTime?
  ownerLabel             String?
  priorityModules        String[]            @default([])
  // Posiciones normalizadas [0..1] por módulo para el canvas visual de
  // la pestaña Datos. Forma: { "<nombreDelModulo>": { "x": 0..1, "y": 0..1 } }.
  // Solo afecta la vista; no participa en pruebas ni análisis.
  modulesLayout          Json?
  executionSettings      Json?
  revision               Int                 @default(0)
  ownerId                String?
  owner                  User?               @relation(fields: [ownerId], references: [id])
  members                ProjectMember[]
  environments           Environment[]
  roles                  TestRole[]
  documents              Document[]
  documentAnalyses       DocumentAnalysis[]
  requirements           Requirement[]
  scenarios              TestScenario[]
  scenarioModuleSequences ScenarioModuleSequence[]
  runs                   TestRun[]
  performanceAudits      PerformanceAudit[]
  monitors               Monitor[]
  loadTests              LoadTest[]
  automationJobs         AutomationJob[]
  automationValidations  AutomationValidation[]
  uxAudits               UxAudit[]
  assessments            QualityAssessment[]
  explorations           Exploration[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Environment {
  id                     String           @id @default(uuid())
  projectId              String
  project                Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                   EnvironmentType?
  // Conserva la columna de la migración publicada sin exponerla en Prisma Client.
  version                String?          @ignore
  baseUrl                String?
  accessMode             AccessMode?
  authorizationConfirmed Boolean          @default(false)
  authorizedAt           DateTime?
  position               Int              @default(0)
  allowedHosts           Json
  allowedPaths           Json             @default("[]")
  excludedPaths          Json             @default("[]")
  prohibitedActions      String[]         @default([])
  testData               Json?
  readOnly               Boolean          @default(true)
  credentialUser         String?
  credentialCipher       String?
  // Sesión importada por el QA para que los tests no se logueen de nuevo.
  // El blob (cookies+localStorage de Playwright) va cifrado con SecretCipher;
  // el worker lo descifra justo antes de inyectarlo con test.use({ storageState }).
  storageStateCipher     String?
  storageStateLabel      String?
  storageStateUploadedAt DateTime?
  storageStateExpiresAt  DateTime?
  explorations           Exploration[]
  runs                   TestRun[]
  performanceAudits      PerformanceAudit[]
  monitors               Monitor[]
  loadTests              LoadTest[]
  uxAudits               UxAudit[]
  createdAt              DateTime         @default(now())
}

model TestRole {
  id              String  @id @default(uuid())
  projectId       String
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  secretReference String?
  permissions     Json    @default("[]")
  description     String?

  @@unique([projectId, name])
}

enum DocumentFormat {
  PDF
  DOCX
  XLSX
  CSV
  TXT
  MD
  JSON
  YAML
  YML
}

enum ClassificationSource {
  PENDING
  MANUAL
  AUTOMATIC
}

enum FindingKind {
  USER_STORY
  FUNCTIONAL
  NON_FUNCTIONAL
  REQUIREMENT
  ACCEPTANCE_CRITERION
  BUSINESS_RULE
  ROLE
  PERMISSION
  SCENARIO
  AMBIGUITY
  CONTRADICTION
}

model Document {
  id                   String               @id @default(uuid())
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                 DocumentType
  classificationSource ClassificationSource @default(PENDING)
  filename             String
  legacyStorageKey     String?              @map("storageKey")
  version              Int                  @default(1)
  versions             DocumentVersion[]
  removedAt            DateTime?
  createdAt            DateTime             @default(now())
  // Tipos de prueba a los que aplica este documento (functional_web,
  // mobile_emulated, compatibility, availability, performance, ux,
  // manual). Vacío = General (aplica a todos los tipos habilitados del
  // plan). Cada agente del pipeline filtra por este campo para usar
  // solo la documentación relevante a su dominio.
  testTypes            String[]             @default([])
  testTypesSource      ClassificationSource @default(PENDING)

  @@index([projectId, filename, removedAt])
}

model DocumentVersion {
  id          String                    @id @default(uuid())
  documentId  String
  document    Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  number      Int
  format      DocumentFormat?
  size        Int?
  sha256      String?
  storageKey  String?                   @unique
  uploadedAt  DateTime?
  processedAt DateTime?
  validatedAt DateTime?
  hasText     Boolean                   @default(false)
  analyses    DocumentAnalysis[]
  primaryUses RequirementTraceability[] @relation("PrimarySource")
  relatedUses RequirementTraceability[] @relation("RelatedSource")

  @@unique([documentId, number])
}

model DocumentAnalysis {
  id           String                    @id @default(uuid())
  projectId    String
  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signature    String
  versions     DocumentVersion[]
  warnings     String[]
  findings     RequirementTraceability[]
  requirements Requirement[]
  criteria     AcceptanceCriterion[]
  rules        BusinessRule[]
  assessment   QualityAssessment?
  createdAt    DateTime                  @default(now())

  @@unique([projectId, signature])
}

model Requirement {
  id                 String                    @id @default(uuid())
  projectId          String
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisId         String?
  analysis           DocumentAnalysis?         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  kind               FindingKind?
  externalKey        String?
  module             String?
  title              String
  description        String?
  acceptanceCriteria Json?
  scenarios          TestScenario[]
  monitors           Monitor[]
  performanceAudits  PerformanceAudit[]
  loadTests          LoadTest[]
  uxAudits           UxAudit[]
  criteria           AcceptanceCriterion[]
  sources            RequirementTraceability[]

  @@index([analysisId])
}

model AcceptanceCriterion {
  id            String                    @id @default(uuid())
  analysisId    String
  analysis      DocumentAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   Requirement?              @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  text          String
  sources       RequirementTraceability[]

  @@index([analysisId])
}

model BusinessRule {
  id         String                    @id @default(uuid())
  analysisId String
  analysis   DocumentAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  text       String
  sources    RequirementTraceability[]

  @@index([analysisId])
}

model RequirementTraceability {
  id                  String               @id @default(uuid())
  analysisId          String
  analysis            DocumentAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  ordinal             Int
  kind                FindingKind
  text                String
  pendingConfirmation Boolean
  // Motivo que la IA aporta cuando marca un finding como pendingConfirmation.
  // Null cuando el finding vino del analizador por reglas o cuando la IA no
  // justificó la ambigüedad.
  pendingReason       String?
  clarification       Json?
  versionId           String
  version             DocumentVersion      @relation("PrimarySource", fields: [versionId], references: [id], onDelete: Cascade)
  locator             String
  relatedVersionId    String?
  relatedVersion      DocumentVersion?     @relation("RelatedSource", fields: [relatedVersionId], references: [id], onDelete: Cascade)
  relatedLocator      String?
  requirementId       String?
  requirement         Requirement?         @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  criterionId         String?
  criterion           AcceptanceCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  ruleId              String?
  rule                BusinessRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([analysisId, ordinal])
}

model ScenarioModuleSequence {
  projectId   String
  prefix      String
  lastOrdinal Int
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, prefix])
}

model TestScenario {
  id             String       @id @default(uuid())
  caseCode        String?
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId  String?
  requirement    Requirement? @relation(fields: [requirementId], references: [id])
  title          String
  tags           String[]     @default([])
  steps          Json
  expectedResult String?
  automation     Json?
  archivedAt     DateTime?
  requirementReviewRequiredAt DateTime?
  results        TestResult[]
  runs           TestRun[]

  @@index([projectId, archivedAt])
}

model TestRun {
  id              String        @id @default(uuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarioId      String?
  scenario        TestScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  environmentId   String?
  environment     Environment?  @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  status          RunStatus     @default(QUEUED)
  startedAt       DateTime?
  completedAt     DateTime?
  errorCode       String?
  runKey          String?       @unique
  createdByUserId String?
  createdBy       User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  specText          String?
  automation        Json?
  writeAuthorizationAt DateTime?
  targetBrowser     String?
  targetDevice      String?
  targetProvider    String?
  providerSessionUrl String?
  results           TestResult[]
  createdAt       DateTime      @default(now())

  @@index([projectId, status, createdAt])
  @@index([projectId, scenarioId, createdAt])
}

model TestResult {
  id           String       @id @default(uuid())
  runId        String
  run          TestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioId   String
  scenario     TestScenario @relation(fields: [scenarioId], references: [id])
  status       ResultStatus
  durationMs   Int?
  errorMessage String?
  evidenceKey  String?
  // Manifiesto de evidencias por paso. Estructura esperada:
  //   { trace: "hex32", video: "hex32" | null,
  //     screenshots: [{ step: 1, action: "goto", key: "hex32", status: "pass"|"fail" }] }
  // Convive con evidenceKey (trace zip) para retro-compatibilidad; evidenceKey
  // se sigue poblando mientras los clientes antiguos esperen la ruta /trace.
  evidence     Json?
}

// Pipeline "Automatizar proyecto": orquesta la cadena de agentes IA
// (convertir docs → revisar → IPA → selección → generar casos). Cada
// paso guarda su resultado en el campo `steps` para diagnóstico.
model AutomationJob {
  id              String       @id @default(uuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          RunStatus    @default(QUEUED)
  stage           String       @default("pending")
  inputs          Json
  steps           Json         @default("{}")
  result          Json?
  errorCode       String?
  runKey          String?      @unique
  createdByUserId String?
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model AutomationValidation {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId   String
  environmentType EnvironmentType
  scopeSignature  String
  createdByUserId String
  repository      String
  workflowRunId   String?
  version         String
  cases           Json
  status          RunStatus @default(QUEUED)
  errorCode       String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([projectId, createdAt])
}

model LoadTest {
  id              String       @id @default(uuid())
  caseCode        String?
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  environmentId   String?
  environment     Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  name            String
  url             String
  automationSignature String?
  automationCode      String?
  automationReview    String?
  stages          Json
  thresholds      Json?
  status          RunStatus    @default(QUEUED)
  startedAt       DateTime?
  completedAt     DateTime?
  errorCode       String?
  runKey          String?      @unique
  createdByUserId String?
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Métricas de resumen (null hasta que k6 termine).
  totalRequests Int?
  reqPerSec     Float?
  failRate      Float?
  p50Ms         Int?
  p95Ms         Int?
  p99Ms         Int?
  maxVus        Int?
  durationSec   Int?

  // Resumen completo de k6 en el ScreenshotStorage.
  summaryKey String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// UxAudit: auditoría asistida por IA de usabilidad + accesibilidad.
// Al ejecutarse, el worker abre la URL con Playwright, captura screenshot
// y árbol a11y, lo pasa al LLM con heurísticas de Nielsen + WCAG básico,
// y guarda findings categorizados por severidad.
model UxAudit {
  id              String       @id @default(uuid())
  caseCode        String?
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  environmentId   String?
  environment     Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  url             String
  automationSignature String?
  automationCode      String?
  automationReview    String?
  status          RunStatus    @default(QUEUED)
  startedAt       DateTime?
  completedAt     DateTime?
  errorCode       String?
  runKey          String?      @unique
  createdByUserId String?
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Agregados para dashboards (null hasta completar).
  totalFindings Int?
  criticalCount Int?
  majorCount    Int?
  minorCount    Int?

  // El detalle vive en la base. reportKey permite leer los informes anteriores.
  reportDetails Json?
  screenshotKey String?
  reportKey     String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Monitor {
  id              String        @id @default(uuid())
  caseCode        String?
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  environmentId   String?
  environment     Environment?  @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  name            String
  url             String
  automationSignature String?
  automationCode      String?
  automationReview    String?
  intervalMinutes Int           @default(15)
  method          String        @default("GET")
  minStatus       Int           @default(200)
  maxStatus       Int           @default(399)
  timeoutMs       Int           @default(10000)
  active          Boolean       @default(true)
  notifyEmails    String[]      @default([])
  createdByUserId String?
  createdBy       User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Último chequeo: se actualiza cada vez que el worker pasa.
  lastCheckedAt  DateTime?
  lastStatus     String?
  lastLatencyMs  Int?
  lastHttpStatus Int?

  checks    MonitorCheck[]
  createdAt DateTime       @default(now())

  @@index([projectId])
  @@index([active, lastCheckedAt])
}

model MonitorCheck {
  id         String   @id @default(uuid())
  monitorId  String
  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  status     String
  httpStatus Int?
  latencyMs  Int?
  errorCode  String?

  @@index([monitorId, at])
}

model PerformanceAudit {
  id              String       @id @default(uuid())
  caseCode        String?
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  environmentId   String?
  environment     Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  url             String
  automationSignature String?
  automationCode      String?
  automationReview    String?
  status          RunStatus    @default(QUEUED)
  startedAt       DateTime?
  completedAt     DateTime?
  errorCode       String?
  runKey          String?      @unique
  createdByUserId String?
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Puntajes 0-100; null hasta que el audit termine.
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?

  // Métricas Web Vitals en milisegundos (CLS es adimensional).
  fcpMs Int?
  lcpMs Int?
  tbtMs Int?
  cls   Float?
  siMs  Int?

  // Reporte JSON completo subido al ScreenshotStorage.
  reportKey String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model QualityAssessment {
  id         String            @id @default(uuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisId String?           @unique
  analysis   DocumentAnalysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  type       AssessmentType
  score      Int?
  details    Json
  createdAt  DateTime          @default(now())
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  TRIALING
  PAYMENT_FAILED
  CANCELED
  EXPIRED
}

enum AccountTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model Organization {
  id              String               @id @default(uuid())
  name            String
  members         OrganizationMember[]
  invites         OrganizationInvite[]
  audits          AccessAudit[]
  meteredRuns     MeteredRun[]
  meteredMonitors MeteredMonitor[]
  meteredAi       MeteredAi[]
  budgets         OrgBudget[]
  subscription    Subscription?
  projects        Project[]
  createdAt       DateTime             @default(now())
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// Asignación de un usuario a un proyecto específico. Se usa para que
// EDITOR y VIEWER solo vean los proyectos que les asignan OWNER/ADMIN.
// OWNER y ADMIN siguen viendo todos los proyectos de su organización.
// Un usuario puede estar en varios proyectos; cada par (proyecto, usuario)
// es único.
model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  createdByUserId String?

  @@id([projectId, userId])
  @@index([userId])
}

model OrganizationMember {
  userId         String       @id
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(VIEWER)
  joinedAt       DateTime     @default(now())

  @@index([organizationId])
}

model OrganizationInvite {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  // Nombre declarado por quien invita. Se muestra en la tabla de miembros
  // mientras la invitación está pendiente y se pre-rellena en la UI de
  // registro cuando el invitado crea su cuenta.
  name            String?
  role            OrgRole
  // Para EDITOR/VIEWER, projectIds declara a qué proyectos tendrá acceso al
  // aceptar. Para OWNER/ADMIN se ignora porque ven todos los proyectos.
  // Default [] para que las invitaciones heredadas sigan funcionando.
  projectIds      String[]     @default([])
  digest          String       @unique
  expiresAt       DateTime
  invitedByUserId String
  invitedBy       User         @relation("InviteAuthor", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}

model AccessAudit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  targetKind     String?
  targetId       String?
  ip             String?
  at             DateTime     @default(now())

  @@index([organizationId, at])
}

model AccountSession {
  digest    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model AccountToken {
  digest    String           @id
  kind      AccountTokenKind
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@unique([userId, kind])
}

model Plan {
  code          String           @id
  name          String
  priceCop      Int
  maxProjects   Int
  maxRoles      Int
  frequency     String
  parallelRuns  Int
  historyDays   Int
  position      Int
  enabled       Boolean          @default(true)
  subscriptions Subscription[]
  capabilities  PlanCapability[]
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planCode       String
  plan           Plan               @relation(fields: [planCode], references: [code])
  status         SubscriptionStatus @default(PENDING)
  reference      String?            @unique
  quotedPriceCop Int?
  periodEndsAt   DateTime?
  trialUsed      Boolean            @default(false)
  events         BillingEvent[]
  payments       Payment[]
}

model BillingEvent {
  id             String       @id
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  receivedAt     DateTime     @default(now())
}

model Payment {
  reference      String       @id
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  provider       String
  amountCop      Int
  approved       Boolean
  createdAt      DateTime     @default(now())
}

enum CapabilityCode {
  FUNCTIONAL_TESTS
  API_TESTS
  BROWSER_TESTS
  RESPONSIVE_TESTS
  HTTP_MONITORS
  FLOW_MONITORS
  PERFORMANCE_TESTS
  DOCUMENT_ANALYSIS
  DOCUMENT_AI
  IPA
  ICSP
  CI_CD
  ADVANCED_REPORTS
  TRACEABILITY
  LIGHTHOUSE_AUDITS
  LOAD_TESTS
  UPTIME_MONITORS
  CROSS_BROWSER
  DEVICE_CLOUD
  AI_DOCUMENT_ANALYSIS
  AI_SCENARIO_GENERATION
  AI_FAILURE_EXPLANATION
  UX_ANALYSIS
}

enum CapabilityAvailability {
  OPERATIONAL
  BETA
  UPCOMING
  NOT_INCLUDED
}

model PlanCapability {
  planCode           String
  plan               Plan                   @relation(fields: [planCode], references: [code], onDelete: Cascade)
  code               CapabilityCode
  availability       CapabilityAvailability
  label              String
  detail             String?
  position           Int
  browsers           String[]
  monthlyLimit       Int?
  monitorLimit       Int?
  minIntervalMinutes Int?
  maxVirtualUsers    Int?
  maxDurationMinutes Int?

  @@id([planCode, code])
}

enum MeteredRunKind {
  BROWSER
  API
  PERFORMANCE
}

model MeteredRun {
  organizationId           String
  organization             Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runKey                   String
  projectId                String
  kind                     MeteredRunKind
  requestedBrowser         String?
  requestedVirtualUsers    Int?
  requestedDurationMinutes Int?
  month                    DateTime       @db.Date
  reservedBrowserSeconds   Int
  browserSeconds           Int?
  startedAt                DateTime       @default(now())
  completedAt              DateTime?

  @@id([organizationId, runKey])
  @@index([organizationId, month])
  @@index([organizationId, completedAt])
}

model MeteredAi {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  operation      String
  model          String
  inputTokens    Int
  outputTokens  Int
  costCop        Int
  runKey         String?
  month          DateTime     @db.Date
  createdAt      DateTime     @default(now())

  @@index([organizationId, month])
  @@index([organizationId, operation, createdAt])
}

model OrgBudget {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monthKey        String
  aiTokensUsed   Int          @default(0)
  aiCostCop       Int          @default(0)
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, monthKey])
}

model MeteredMonitor {
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitorKey      String
  projectId       String
  intervalMinutes Int
  createdAt       DateTime     @default(now())
  disabledAt      DateTime?

  @@id([organizationId, monitorKey])
  @@index([organizationId, disabledAt])
}

enum ExplorationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum ExplorationLogLevel {
  INFO
  WARN
  ERROR
}

model Exploration {
  id              String              @id @default(uuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId   String
  environment     Environment         @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  startUrl        String
  status          ExplorationStatus   @default(QUEUED)
  limits          Json                @default("{}")
  runKey          String?             @unique
  createdByUserId String?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  queuedAt        DateTime            @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  errorCode       String?
  pages           ExplorationPage[]
  logs            ExplorationLog[]

  @@index([projectId, status])
  @@index([status, queuedAt])
  @@index([projectId, environmentId, startUrl, finishedAt])
}

model ExplorationPage {
  id            String      @id @default(uuid())
  explorationId String
  exploration   Exploration @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  position      Int
  url           String
  httpStatus    Int?
  title         String?
  screenshotKey String?
  domSize       Int?
  // Inventario de elementos interactivos (botones, links, inputs) con su
  // mejor selector disponible. Ver apps/explorer/src/explorer.ts para la
  // extracción y apps/api/src/automation/element-inventory.ts para el
  // consumo. Nunca contiene valores de input, solo atributos estructurales.
  elements      Json?
  visitedAt     DateTime    @default(now())

  @@index([explorationId, position])
}

model ExplorationLog {
  id            String              @id @default(uuid())
  explorationId String
  exploration   Exploration         @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  at            DateTime            @default(now())
  level         ExplorationLogLevel
  code          String
  detail        String?

  @@index([explorationId, at])
}
