DATABASE_URL="postgresql://autoqa:autoqa_local_only@localhost:5432/autoqa?schema=public"
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Genera una clave local con el procedimiento de docs/DOCUMENTS.md.
AUTOQA_DOCUMENTS_TOKEN=
# AUTOQA_DOCUMENTS_DIR=C:/ruta/privada/documentos

# Configura el flujo comercial local según docs/COMMERCIAL.md.
AUTOQA_ACCOUNT_ORIGIN=http://localhost:3000
AUTOQA_INTERNAL_API_URL=http://127.0.0.1:3001/api
AUTOQA_LEGACY_MODE=false
# Usa mailpit para desarrollo y smtp para un proveedor transaccional.
AUTOQA_MAIL_MODE=mailpit
AUTOQA_SMTP_HOST=127.0.0.1
AUTOQA_SMTP_PORT=1025
AUTOQA_MAIL_FROM=no-reply@autoqa.local
# AUTOQA_SMTP_USER=
# AUTOQA_SMTP_PASS=
# AUTOQA_SMTP_SECURE=false
AUTOQA_PAYMENTS_MODE=disabled
AUTOQA_SANDBOX_PAYMENT_SECRET=
AUTOQA_TRIAL_DAYS=0
# Activación manual para demos (vacío = deshabilitada). 64 hex. Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOQA_ADMIN_TOKEN=
# AUTOQA_PUBLIC_WORKSPACE_ORIGIN=https://app.ejemplo.com

# Almacenamiento de capturas de exploración.
# local (por defecto): disco local en AUTOQA_EXPLORATIONS_DIR. El worker y el
#   API deben correr en la misma máquina.
# s3: bucket S3-compatible. Soporta Hostinger Object Storage, Cloudflare R2,
#   Backblaze B2, DigitalOcean Spaces, AWS S3, MinIO.
AUTOQA_EXPLORATIONS_BACKEND=local
# AUTOQA_EXPLORATIONS_DIR=C:/ruta/privada/explorations

# Rellenar SOLO si AUTOQA_EXPLORATIONS_BACKEND=s3.
# AUTOQA_S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com
# AUTOQA_S3_REGION=auto
# AUTOQA_S3_BUCKET=autoqa-screenshots
# AUTOQA_S3_ACCESS_KEY=
# AUTOQA_S3_SECRET_KEY=
# AUTOQA_S3_PREFIX=prod/
# AUTOQA_S3_FORCE_PATH_STYLE=true

# BrowserStack (device cloud). Rellenar en el worker para habilitar
# runs con targetProvider=BROWSERSTACK. Ver docs/DEVICE_CLOUD.md.
# AUTOQA_BROWSERSTACK_USERNAME=
# AUTOQA_BROWSERSTACK_ACCESS_KEY=
# AUTOQA_BROWSERSTACK_BUILD=autoqa-piloto

# IA. Al menos una API key según el modelo default. Ver docs/AI.md.
# AUTOQA_ANTHROPIC_API_KEY=sk-ant-...
# AUTOQA_OPENAI_API_KEY=sk-...
# claude-haiku-4-5 | claude-sonnet-4-5 | gpt-4o | gpt-4o-mini
# AUTOQA_AI_DEFAULT_MODEL=claude-sonnet-4-5

# Minutos durante los cuales una exploración COMPLETED de la misma URL y
# entorno bloquea nuevas creaciones (devuelven 409 reused). El cliente puede
# saltarse el caché con `force: true`. Rango 1..1440, default 15.
# AUTOQA_EXPLORATION_REUSE_MINUTES=15
